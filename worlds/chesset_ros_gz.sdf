    <model name="overhead_camera">
      <static>true</static>
      <pose>0.501 0 1.12 0 1.57079632679 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.1 0.1 0.12 1</diffuse>
          </material>
        </visual>
        <sensor name="overhead_camera" type="camera">
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>overhead_camera/image</topic>
          <camera>
            <horizontal_fov>0.92</horizontal_fov>
            <image>
              <width>960</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>4.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
